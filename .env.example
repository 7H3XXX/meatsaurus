# AgroPortal API key — get one free at https://agroportal.eu (account settings).
API_KEY=

# Optional override, defaults to https://data.agroportal.eu — the lirmm.fr
# host still works but 302-redirects here, so this is the canonical base.
# AGROPORTAL_BASE_URL=https://data.agroportal.eu

# Public site URL, used for metadata (OpenGraph, canonical/hreflang links,
# sitemap.xml). Defaults to http://localhost:3000 if unset.
# NEXT_PUBLIC_SITE_URL=https://meatsaurus.example.com
